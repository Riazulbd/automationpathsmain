# Copy to .env and fill in. Loaded by BOTH Vite (frontend) and the Express server.
# Only VITE_-prefixed vars are exposed to the browser. Find keys in Supabase:
# Project Settings → API.

# ---- Frontend (public, safe to expose; protected by RLS) --------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ---- Server-only (NEVER exposed to the browser) -----------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
QUIZ_DASHBOARD_PASSWORD=choose-a-strong-password

# ---- Blog / CMS (server-only) -----------------------------------------------
# Canonical site origin used for sitemap.xml, RSS, canonical URLs, and OG tags.
SITE_URL=https://automationpaths.com
# Optional: enables the AI writing assistant in the blog editor.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the default AI model (defaults to anthropic/claude-sonnet-4).
OPENROUTER_MODEL=anthropic/claude-sonnet-4
